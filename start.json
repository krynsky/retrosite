{
  "daemon": true,
  "run": [
    {
      "method": "shell.run",
      "params": {
        "path": "app",
        "env": {
          "PORT": "4327",
          "RETROSITE_MODE": "local",
          "RETROSITE_RUNNER_MODE": "inline",
          "RETROSITE_GENERATED_ROOT": "server/generated",
          "RETROSITE_APP_ORIGIN": "http://127.0.0.1:4327",
          "RETROSITE_WEB_URL": "http://127.0.0.1:5273/",
          "RETROSITE_USE_BUNDLED_CHROMIUM": "1"
        },
        "message": "npm run dev:pinokio",
        "on": [
          {
            "event": "/Local:\\s+(http:\\/\\/[^\\s]+)/",
            "done": true
          }
        ]
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "{{input.event[1]}}"
      }
    }
  ]
}
